  {
    "id": "foreignKey.comments.comments_post_id_fkey",
    "label": "Add foreign key \"comments_post_id_fkey\" on \"comments\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "foreignKey",
        "name": "comments_post_id_fkey",
        "table": "comments"
      }
    },
    "precheck": [
      {
        "description": "ensure FK \"comments_post_id_fkey\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "comments_post_id_fkey",
          "public",
          "\"public\".\"comments\""
        ]
      }
    ],
    "execute": [
      {
        "description": "add FK \"comments_post_id_fkey\"",
        "sql": "ALTER TABLE \"public\".\"comments\"\nADD CONSTRAINT \"comments_post_id_fkey\"\nFOREIGN KEY (\"post_id\")\nREFERENCES \"public\".\"posts\" (\"id\")\nON DELETE CASCADE"
      }
    ],
    "postcheck": [
      {
        "description": "verify FK \"comments_post_id_fkey\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "comments_post_id_fkey",
          "public",
          "\"public\".\"comments\""
        ]
      }
    ]
  }
